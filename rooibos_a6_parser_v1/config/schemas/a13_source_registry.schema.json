{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rooibos.invalid/schemas/a13-source-registry-1.0.0.json",
  "title": "Rooibos A13 Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "policy_version", "status", "sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_version": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed_not_approved", "approved", "suspended", "retired"]},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "display_name", "independent_group", "approval_reference", "approved_by", "approved_at", "expires_at", "endpoints"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "independent_group": {"type": "string", "minLength": 1},
        "approval_reference": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "endpoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/endpoint"}}
      }
    },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint_id", "dataset_types", "chains", "evidence_fields"],
      "properties": {
        "endpoint_id": {"type": "string", "minLength": 1},
        "dataset_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["a1_discovery", "a2_market", "a6_ohlcv"]}},
        "chains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
